@model IList<test111.Models.BorrowedItem>
<table class="table table-bordered" id="borrowTable">
    <thead>
        <tr>
            <th>Book</th>
            <th>Author</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count>0)
        {
            for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>
                        <input type="hidden" name="BorrowedItems[@i].BorrowedId" value="0" />
                        <input type="text" name="BorrowedItems[@i].BookName" value="@Model[i].BookName" />
                    </td>
                    <td>
                       
                        <input type="text" name="BorrowedItems[@i].AuthorName" value="@Model[i].AuthorName" />
                    </td>
                    <td>
                       <button type="button" class="btn btn-danger btnRemove">Remove</button>
                    </td> 
                </tr>
            }
        }
    </tbody>
</table>